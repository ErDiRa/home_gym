# Copy to deploy/.env on the server and fill in.

# Public host name; Caddy gets its certificate for it (DNS must point at the server)
DOMAIN=homegym.example.com
# Image built and pushed with `task image:push`
APP_IMAGE=ghcr.io/your-user/homegym:latest

POSTGRES_USER=homegym
# openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=homegym

# openssl rand -base64 48
JWT_SECRET=

# debug | info | warn | error
LOG_LEVEL=info

# Optional: the WHOOP app (developer.whoop.com, scopes read:workout read:recovery offline,
# redirect URL https://<DOMAIN>/api/whoop/callback). Leave empty to turn WHOOP off.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
